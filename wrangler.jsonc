// Cloudflare static hosting for the SPA. No Worker script: assets only.
// Deploy (owner only): pnpm build && npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personalsite-help",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "workers_dev": true,
  // personalsitehelp.com redirects here via a Cloudflare redirect rule on its zone.
  "routes": [
    { "pattern": "personalsite.help", "custom_domain": true },
    { "pattern": "www.personalsite.help", "custom_domain": true },
  ],
}
