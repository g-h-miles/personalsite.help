# Frontend (Vite) — copy to .env.local
# Written for you by `npx convex dev` on first run.
VITE_CONVEX_URL=
# Clerk dashboard → API keys.
VITE_CLERK_PUBLISHABLE_KEY=

# Convex deployment env — set with `npx convex env set NAME value`, not read from this file.
# CLERK_JWT_ISSUER_DOMAIN=https://<your-instance>.clerk.accounts.dev   (required)
# JUDGMENT_PROVIDER=mock | jev | openai-decisions                        (default: mock)
# JEV_API_KEY=                                                           (only if JUDGMENT_PROVIDER=jev)
# OPENAI_API_KEY=                                                        (openai-decisions; later, tier-2 deep audit)
